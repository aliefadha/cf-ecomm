{
	"name": "cf-ecomm",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.2.2",
			"zod": "^4.1.13",
			"typescript": "^5",
			"@types/node": "^22.13.14",
			"@cloudflare/workers-types": "^4.20251213.0",
			"hono": "^4.8.2",
			"@orpc/server": "^1.12.2",
			"@orpc/openapi": "^1.12.2",
			"@orpc/zod": "^1.12.2",
			"better-auth": "1.5.5",
			"alchemy": "^0.90.0",
			"@libsql/client": "0.15.15",
			"libsql": "0.5.22",
			"@orpc/client": "^1.12.2",
			"drizzle-orm": "^0.45.1"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "STAGE=local turbo dev",
		"build": "STAGE=local turbo build",
		"check-types": "STAGE=local turbo check-types",
		"check": "STAGE=local biome check --write .",
		"lint": "STAGE=local biome check .",
		"dev:web": "STAGE=local turbo -F web dev",
		"dev:server": "STAGE=local turbo -F server dev",
		"db:push": "turbo -F @cf-ecomm/db db:push",
		"db:generate": "turbo -F @cf-ecomm/db db:generate",
		"deploy": "STAGE=prod turbo -F @cf-ecomm/infra deploy",
		"deploy:dev": "STAGE=dev turbo -F @cf-ecomm/infra deploy",
		"destroy": "turbo -F @cf-ecomm/infra destroy",
		"test": "echo 'No tests configured'"
	},
	"dependencies": {
		"@cf-ecomm/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@cf-ecomm/config": "workspace:*",
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"turbo": "^2.8.12",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.3"
}
